(version 1)

###############################
#IEC 60664-1 OVC II PD2 MIIIa #
#    Reinforced Isolation     #
###############################

(rule VIHigh_DGND
   # Set clearance for IBus tracks to digital
   (constraint clearance (min 0,5mm))
   (condition "A.hasNetClass('IBUS') && B.hasNetClass('DGND')"))

(rule SW1_DGND
   # Set clearance for SW1 tracks to digital 
   (constraint clearance (min 0,5mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('DGND')"))

(rule SW2_DGND
   # Set clearance for SW2 tracks to digital
   (constraint clearance (min 0,5mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('DGND')"))

(rule PGND_DGND
   # Set clearance for PGND tracks to digital
   (constraint clearance (min 0,5mm))
   (condition "A.hasNetClass('PGND') && B.hasNetClass('DGND')"))

(rule VIHigh_DGND_outer
   # Set clearance for IBus tracks to digital
   (layer outer)
   (constraint clearance (min 2.8mm))
   (condition "A.hasNetClass('IBUS') && B.hasNetClass('DGND')"))

(rule SW1_DGND_outer
   # Set clearance for SW1 tracks to digital 
   (layer outer)
   (constraint clearance (min 2.8mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('DGND')"))

(rule SW2_DGND_outer
   # Set clearance for SW2 tracks to digital
   (layer outer)
   (constraint clearance (min 2.8mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('DGND')"))

(rule PGND_DGND_outer
   # Set clearance for PGND tracks to digital
   (layer outer)
   (constraint clearance (min 2.8mm))
   (condition "A.hasNetClass('PGND') && B.hasNetClass('DGND')"))

