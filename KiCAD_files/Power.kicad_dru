##################
# NetClass rules # 
##################

########################
## BUSES to GND rules ##
########################

(rule IBUS_GND
   # Set clearance for IBus tracks to ground
   (layer outer)
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetClass('IBUS') && !A.enclosedByArea('Exception_NCP12700') && B.hasNetClass('PGND')"))

(rule IBUS_GND
   # Set clearance for IBus tracks to ground
   (constraint clearance (min 0.5mm))
   (condition "A.hasNetClass('IBUS') && !A.enclosedByArea('Exception_NCP12700') && B.hasNetClass('PGND')"))

####################################
## BUSES to SWITCHING nodes rules ##
####################################

(rule SWN1_IBUS
   # Set clearance for SWN1 tracks to IBUS
   (layer outer)
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('IBUS')"))

(rule SWN2_IBUS
   # Set clearance for SWN2 tracks to IBUS
   (layer outer)
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('IBUS')"))

(rule SWN1_IBUS
   # Set clearance for SWN1 tracks to IBUS
   (constraint clearance (min 0.5mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('IBUS')"))

(rule SWN2_IBUS
   # Set clearance for SWN2 tracks to IBUS
   (constraint clearance (min 0.5mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('IBUS')"))

##################################
## SWITCHING nodes to GND rules ##
##################################

(rule SWN1_GND
   # Set clearance for SWN1 tracks to ground
   (layer outer)
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('PGND')"))

(rule SWN2_GND
   # Set clearance for SWN2 tracks to ground
   (layer outer)
   (constraint clearance (min 0.75mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('PGND')"))

(rule SWN1_GND
   # Set clearance for SWN1 tracks to ground
   (constraint clearance (min 0.5mm))
   (condition "A.hasNetClass('SWN1') && B.hasNetClass('PGND')"))

(rule SWN2_GND
   # Set clearance for SWN2 tracks to ground
   (constraint clearance (min 0.5mm))
   (condition "A.hasNetClass('SWN2') && B.hasNetClass('PGND')"))

(rule "clearance-to-1mm-cutout"
    (constraint clearance (min 0.8mm))
    (condition "A.Layer=='Edge.Cuts' && A.Thickness == 1.0mm"))

